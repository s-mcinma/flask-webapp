# .env — development only; never commit this file with real credentials
# Copy to /var/www/webapp/.env on the EC2 instance for production use,
# OR use the SetEnv directives in webapp.conf instead.

DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=your-password
DB_NAME=webapp_db
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=false
